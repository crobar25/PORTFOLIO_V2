---
interface Props {
    title?: string;
    includeGallery?: boolean;
    includeRing?: boolean;
    /** Render a Back link in the top-left, pointing at this page. */
    backTo?: string;
}

const {
    title = "Connor Ng",
    includeGallery = false,
    includeRing = false,
    backTo,
} = Astro.props;
---
<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <meta name="generator" content={Astro.generator} />
        <title>{title}</title>
        <link href="/css/styles.css" rel="stylesheet"/>
        {includeGallery && <link href="/css/gallery.css" rel="stylesheet"/>}
        {includeRing && <link href="/css/ring.css" rel="stylesheet"/>}
        <link href="/css/ham-menu.css" rel="stylesheet"/>
        <meta name="theme-color" content="#808080" />
        <script src="/javascript/script.js" defer></script>
        <script src="/javascript/video-nav.js" defer></script>
        {includeRing && <script src="/javascript/ring.js" defer></script>}
        <link rel="icon" href="/assets/photogallery/favicon_ng.png" type="image/png" sizes="32x32">
    </head>
    <body>
        <header class="nav-header">
            <a class="nav-item" href="/">Connor Ng</a>
            <nav class="header-nav">
                <div class="dropdown">
                    <div class="nav-item">Work</div>
                    <div class="dropdown-content">
                        <a class="nav-item drop-link" href="/work/software/">projects</a>
                        <a class="nav-item drop-link" href="/work/video/">creative portfolio</a>
                        <a class="nav-item drop-link" href="/work/photowall">photo wall</a>
                    </div>
                </div>
                <a class="nav-item" href="/aboutme">About Me</a>
            </nav>
            <div class="off-screen-menu">
                <div class="menu-header">
                    <span class="menu-name">Connor Ng</span>
                    <p class="menu-subtitle">student developer, photographer, videographer, explorer.</p>
                </div>
                <nav class="menu-links">
                    <a class="menu-link" href="/">Home</a>
                    <a class="menu-link" href="/work/software/">Software</a>
                    <a class="menu-link" href="/work/video/">Visual Projects</a>
                    <a class="menu-link" href="/work/photowall">Photo Wall</a>
                    <a class="menu-link" href="/aboutme">About Me</a>
                </nav>
            </div>
            <div class="ham-menu">
                <span></span>
                <span></span>
                <span></span>
            </div>
        </header>

        {backTo && (
            <a class="back-link" href={backTo} data-back-link>Back</a>
        )}

        <slot />

        <footer>
            <div class="info">
                <div class="left-col-content">
                    <h2>Let's make cool stuff together...</h2>
                </div>
                <div class="right-col-content">
                    <p>Let's connect!</p>
                    <a href="https://www.instagram.com/ngconnor_/" target="blank">instagram</a>
                    <a href="https://www.linkedin.com/in/connor-ng-8b6753342/" target="blank">linkedin</a>
                </div>
            </div>
            <div class="divider"></div>
            <div class="fineprint">
                <p>©2026 CONNOR NG.</p>
                <p>based in New York City.</p>
            </div>
            <div class="scroller" data-content="Connor Ng">
                <div class="track">
                    <h1 class="scroll-text">Connor Ng</h1>
                    <h1 class="scroll-text">Connor Ng</h1>
                </div>
            </div>

        </footer>
        <div class="bottom-glass-blur" aria-hidden="true">
            <div></div><div></div><div></div><div></div><div></div><div></div>
        </div>
    </body>
</html>

<style>
    /* Sits in the empty top-left corner, level with the page title. Absolute
       against the document rather than in the flow, so it doesn't push the
       centred heading down. The nav-header is fixed at z-index 9999, so this
       passes under it on scroll. */
    .back-link {
        position: absolute;
        top: 104px;
        left: 30px;
        z-index: 10;
        display: inline-flex;
        align-items: baseline;
        gap: 8px;
        padding: 6px 14px 6px 12px;
        /* border-radius: 999px; */
        font-family: 'Helvetica', 'Helvetica Neue', Arial, sans-serif;
        font-size: 17px;
        line-height: 1;
        color: rgb(10, 10, 10);
        background-color: rgba(255, 255, 255, 0);
        transition: background-color 0.25s ease, transform 0.25s ease;
    }

    .back-link::before {
        content: "\2190";           /* ← */
        font-size: 18px;
    }

    .back-link:hover,
    .back-link:focus-visible {
        /* background-color: rgba(255, 255, 255, 0.85); */
        color: rgb(149, 149, 149);
        transform: translateX(-3px);
    }

    @media (max-width: 760px) {
        .back-link {
            top: 88px;
            left: 14px;
            font-size: 15px;
            padding: 6px 12px 6px 10px;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .back-link {
            transition: none;
        }
        .back-link:hover,
        .back-link:focus-visible {
            transform: none;
        }
    }
</style>
