---
import Layout from '../layouts/Layout.astro';
---
<Layout includeGallery>
    <div class="fullscreen-content">
        <div class="content">
            <div class="heading">
                <span class="title">about me.</span>
                <span class="subtext">who even is this guy</span>
            </div>
                <video class="me-vid" width="640" height="360" autoplay muted playsinline loop>
                    <source src="/assets/photogallery/working.webm" type="video/webm">
                    <source src="/assets/photogallery/working.mp4" type="video/mp4">
                </video>
            <p class="spaced-text">Hi! I'm <b>Connor</b>, and I'm a student at <b>New York University</b> studying <b>computer science</b> and mathematics.</p>

            <p>
                I was born and raised in the great Tri-State area, and eventually moved to New York
                to attend NYU. I'm passionate about building whatever gets me thinking and learning, 
                whether that be tech, videography, or photography. 
            </p>
            <p>
                
            </p>
            <p>
                If you see me on campus or out and about around the city, don't hesitate to say hello.
                I'm always open to meeting people and talking about film, cameras, and project ideas!
            </p>
        </div>
    </div>
</Layout>
