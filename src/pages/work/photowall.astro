---
import Layout from '../../layouts/Layout.astro';
import { getImage } from 'astro:assets';

const imageModules = import.meta.glob<{ default: ImageMetadata }>(
    '../../assets/photowall/*.{jpg,jpeg,png,webp,avif,gif}',
    { eager: true }
);

const images = await Promise.all(
    Object.entries(imageModules)
        .sort(([a], [b]) => a.localeCompare(b))
        .map(async ([, mod]) => {
            const source = mod.default;
            const [thumb, full] = await Promise.all([
                getImage({ src: source, width: 700, format: 'webp', quality: 78 }),
                getImage({ src: source, width: 2000, format: 'webp', quality: 88 }),
            ]);
            return {
                thumbSrc: thumb.src,
                thumbWidth: thumb.attributes.width,
                thumbHeight: thumb.attributes.height,
                fullSrc: full.src,
            };
        })
);
---
<Layout title="Connor Ng — Photo Wall" includeGallery>
    <div class="fullscreen-content">
        <div class="heading">
            <span class="title">photo wall</span>
            <span class="subtext">the world, through my eyes. Click on photos to enlarge!</span>
        </div>

        {images.length > 0 ? (
            <div class="photowall">
                {images.map((image) => (
                    <div class="photowall-item">
                        <img
                            class="photowall-img"
                            src={image.thumbSrc}
                            data-full={image.fullSrc}
                            width={image.thumbWidth}
                            height={image.thumbHeight}
                            alt=""
                            loading="lazy"
                        />
                    </div>
                ))}
            </div>
        ) : (
            <p class="photowall-empty">No photos yet — drop some into <code>src/assets/photowall/</code> and they'll show up here automatically.</p>
        )}
    </div>

    <div class="lightbox" id="lightbox">
        <div class="lightbox-scrim"></div>
        <div class="lightbox-blur" aria-hidden="true">
            <div></div><div></div><div></div><div></div><div></div>
        </div>
        <button class="lightbox-close" id="lightbox-close" aria-label="Close">&times;</button>
        <img class="lightbox-img" id="lightbox-img" src="" alt="" />
    </div>
</Layout>
