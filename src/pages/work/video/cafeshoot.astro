---
import Layout from '../../../layouts/Layout.astro';
---
<Layout includeGallery>
    <div class="fullscreen-content">
         <div class="heading">
            <span class="title">Cafe Hasbrouck Heights</span>
            <span class="subtext">videography, photography, graphic design</span>
        </div>
        <div class="content">
                <video class="me-vid" width="640" preload="none" poster = "/assets/photogallery/cafehh/coffee_5.1.1.jpg" controls playsinline loop>
                    <source src="/assets/photogallery/cafehh/Cafe Latte.webm" type="video/webm">
                    <source src="/assets/photogallery/cafehh/Cafe Latte.mp4" type="video/mp4">
                </video>
        </div>
        <div class="writeup">
            <div class="writeup-text"><b>Social media assets</b> made for <b>Cafe Hasbrouck Heights</b>. Focused on creating attractive visuals (videos, photos, graphics) highlighting the store's products.</div>
            <a target="blank" href="https://www.instagram.com/cafehasbrouckheights/"><img class = "writeup-img" src="../../assets/photogallery//cafehh/cafehh.png"></a>
        </div>

        <div class="photogallery">
            <img src="/assets/photogallery/cafehh/bestsellers.jpg">
            <img src="/assets/photogallery/cafehh/DSC03299.jpg">
            <img src="/assets/photogallery/cafehh/bananamatchalatte.jpg">
            <img src="/assets/photogallery/cafehh/DSC03306-Recovered.jpg">
            <img src="/assets/photogallery/cafehh/DSC03354.jpg">
        </div>
    </div>
</Layout>
