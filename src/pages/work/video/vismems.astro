---
import Layout from '../../../layouts/Layout.astro';
---
<Layout includeGallery>
    <div class="fullscreen-content">
         <div class="heading">
            <span class="title">visual memoirs</span>
            <span class="subtext">personal videos, faster-paced edits to document the cool things i'm doing.</span>
        </div>
        <div class="content">
            <span class="subtext">Latest Video:</span>
                <video class="me-vid" width="640" poster = "/assets/photogallery/garden_1.1.2.jpg"  controls playsinline loop>
                    <source src="/assets/photogallery/Bamboo Garden.webm" type="video/webm">
                    <source src="/assets/photogallery/Bamboo Garden.mp4" type="video/mp4">
                </video>
                <video class="me-vid" width="640" poster = "/assets/photogallery/fireworks.jpg"  controls playsinline loop>
                    <source src="/assets/photogallery/fireworks.webm.webm" type="video/webm">
                    <source src="/assets/photogallery/fireworks.webm" type="video/mp4">
                </video>
        </div>
    </div>
</Layout>
