---
import Layout from '../../../layouts/Layout.astro';
---
<Layout includeGallery>
    <div class="fullscreen-content">
            <video class="bannervid" width="640" height="360" autoplay muted playsinline loop>
                <source src="/assets/photogallery/City.webm" type="video/webm">
                <source src="/assets/photogallery/city.mp4" type="video/mp4">
            </video>
         <div class="heading">
            <span class="title">photo + video</span>
            <span class="subtext">documenting the beauty of everyday life.</span>
        </div>


        <div class="gallery">
            <div class="image-overlay">
                <p>Theta Tau NYU</p>
                <h5>Photo, Video, Graphics</h5>
            <a href="/work/video/thetatau">
                <img src="/assets/photogallery/cafehh/coffee_5.1.1.jpg">
            </a>
            </div>
            <div class="image-overlay">
                <p>Cafe Hasbrouck Heights</p>
                <h5>Documentation, Photo, Video</h5>
            <a href="/work/video/cafeshoot">
                <img src="/assets/photogallery/cafehh/coffee_5.1.1.jpg">
            </a>
            </div>
            <div class="image-overlay">
                <p>Learning to Color Grade</p>
                <h5>Documentation</h5>
            <a href="/work/video/colorgradingdoc">
                <img src="/assets/photogallery/WILL-BOBA-DECENT_1.3.1.jpg">
            </a>
            </div>
            <div class="image-overlay">
                <p>moving postcards</p>
                <h5>Video</h5>
                <a href="/work/video/postcards">
                    <img src="/assets/photogallery/beach.jpg">
                </a>
            </div>
            <div class="image-overlay">
                <p>the tandon zine</p>
                <h5>Video</h5>
            <a href="/work/video/tandonzine">
                <img src="/assets/photogallery/tandonzine.jpg">
            </a>
            </div>
            <div class="image-overlay">
                <p>VISUAL MEMOIRS series</p>
                <h5>Video</h5>
                <a href="/work/video/vismems">
                    <img src="/assets/photogallery/garden_1.1.2.jpg">
                </a>
            </div>
        </div>
        <p class="centered-titles">more to come...</p>
    </div>
</Layout>
