---
import Layout from '../../../layouts/Layout.astro';
---
<Layout includeGallery>
    <div class="fullscreen-content">

         <div class="heading">
            <span class="title">the tandon zine</span>
            <span class="subtext">videography, photography, graphic design</span>
        </div>
        <div class="content">
                <video class="me-vid" width="640" preload="none" poster = "/assets/photogallery/tandonzine.jpg"  controls playsinline loop>
                    <source src="/assets/photogallery/Tandonzine.webm" type="video/webm">
                </video>
        </div>
        <div class="writeup">
            <div class="writeup-text"><b>Social media assets</b> made for <b>The Blueprint</b>, a Zine publication led by students displaying the creative works of engineers and students at <b>NYU's Tandon School of Engineering</b>.</div>
            <a target="blank" href="https://www.blueprintzine.org/"><img class = "writeup-img" src="../../assets/photogallery/BlueprintLogo.png"></a>
        </div>
    </div>
</Layout>
