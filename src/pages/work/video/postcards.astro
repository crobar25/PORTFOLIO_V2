---
import Layout from '../../../layouts/Layout.astro';
---
<Layout includeGallery>
    <div class="fullscreen-content">

         <div class="heading">
            <span class="title">moving postcards</span>
            <span class="subtext">simple compositions to document my life, the places i go to, and the people that give life meaning.</span>
        </div>
        <div class="writeup">
            <div class="gallery">
            <video class="stdvid" width="640"   loop playsinline controls>
                    <source src="/assets/photogallery/Post1.mp4" type="video/mp4">
                    <source src="/assets/photogallery/Post1.mp4" type="video/webm">
                </video>
            <video class="stdvid" width="640"   controls  playsinline loop>
                    <source src="/assets/photogallery/Post2.webm" type="video/mp4">
                    <source src="/assets/photogallery/Post2.mp4" type="video/webm">
                </video>
            <video class="stdvid" width="640"   controls  playsinline loop>
                    <source src="/assets/photogallery/Post3.webm" type="video/mp4">
                    <source src="/assets/photogallery/Post3.mp4" type="video/webm">
                </video>
            <video class="stdvid" width="640"   controls  playsinline loop>
                    <source src="/assets/photogallery/Post4.webm" type="video/webm">
                    <source src="/assets/photogallery/Post4.mp4" type="video/mp4">
                </video>
            <video class="stdvid" width="640"   controls  playsinline loop>
                    <source src="/assets/photogallery/Post5.webm" type="video/webm">
                    <source src="/assets/photogallery/Post5.mp4" type="video/mp4">
                </video>
            </div>
        </div>
    </div>
</Layout>
