---
import Layout from '../../../layouts/Layout.astro';
---

<Layout includeGallery>
    <div class="fullscreen-content">
        <div class="heading">
            Theta Tau NYU
        </div>
        <div class="subtext">A professional engineering fraternity at the NYU Tandon School of Engineering</div>
    </div>
    <div class="content">
                <video class="me-vid" width="640" preload="none" poster = "/assets/photogallery/tandonzine.jpg"  controls playsinline loop>
                    <source src="/assets/photogallery/Tandonzine.webm" type="video/webm">
                </video>
                <div class="subtext">Theta Tau's Fall Rush 2026 Video, edited on Davinci Resolve.</div>
        </div>
    <div class="writeup">
        <div class="writeup-text">I am the Historian, Webmaster, and Public Resources/Digital Design chair at NYU's Theta Tau Epsilon Chapter. I'm responsible for maintaining the Theta Tau Website and producing aesthetic and well-designed posters, graphics, and videos to promote events as well as increase social media prescence.</div>
    </div>
    
</Layout>