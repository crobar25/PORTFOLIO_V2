---
import Layout from '../layouts/Layout.astro';
import { getImage } from 'astro:assets';

const photowallModules = import.meta.glob<{ default: ImageMetadata }>(
    '../assets/photowall/*.{jpg,jpeg,png,webp,avif,gif}',
    { eager: true }
);

// Panels on the hero ring. Stills come from src/assets/photowall/ so Astro
// optimizes them; `video` entries are served straight from /public and play
// on the ring. Reorder or swap `file` values to change what's on the reel.
const ringConfig = [
    { file: 'DSC03661.jpg',           href: '/work/photowall', alt: 'Photography' },
    { video: '/assets/photogallery/City.webm', href: '/work/video/', alt: 'Visual projects reel' },
    { file: 'ALLENLU_VOGUE.jpeg',     href: '/work/photowall', alt: 'Photography' },
    { file: 'DSC04143.jpg',           href: '/work/photowall', alt: 'Photography' },
    { file: 'bigislandddd_2.1.2.jpg', href: '/work/photowall', alt: 'Photography' },
    { file: 'skyline-pic.jpg',        href: '/work/photowall', alt: 'Photography' },
    { file: 'DSC04642.jpg',           href: '/work/photowall', alt: 'Photography' },
    { file: 'DSC06069.jpg',           href: '/work/photowall', alt: 'Photography' },
    { file: 'DSC05234-6.jpg',         href: '/work/photowall', alt: 'Photography' },
    { file: 'bananamatchalatte.jpg',  href: '/work/photowall', alt: 'Photography' },
];

const ringClips = await Promise.all(
    ringConfig.map(async (item) => {
        if (item.video) {
            return { src: item.video, video: true, href: item.href, alt: item.alt };
        }
        const mod = photowallModules[`../assets/photowall/${item.file}`];
        const optimized = await getImage({
            src: mod.default,
            width: 700,
            format: 'webp',
            quality: 78,
        });
        return { src: optimized.src, href: item.href, alt: item.alt };
    })
);

const roleWords = ['software development', 'creative direction', 'photographer', 'videographer'];
---
<Layout includeGallery includeRing>
    <div class="fullscreen-content">
        <section class="ring-hero" aria-label="Featured work">
            <div
                class="ring-stage"
                data-ring-stage
                data-ring-clips={JSON.stringify(ringClips)}
            ></div>
        </section>

        <section class="hero">
            <h1 class="hero-name">Connor Ng</h1>

            <div class="hero-role">
                <span class="sr-only">{roleWords.join(', ')}</span>
                <div class="role-viewport" aria-hidden="true">
                    <span class="role-word role-a" id="role-a">{roleWords[0]}</span>
                    <span class="role-word role-b" id="role-b"></span>
                </div>
            </div>
        </section>

        <div class="intro-layout">
            <div class="intro-photo">
                <img src="/assets/photogallery/mephoto.png" alt="Connor Ng">
            </div>
            <div class="intro-text">
                <p><b>CONNOR NG</b> is a student at <b>New York University</b> studying computer science.</p>
                <p>His interests lie in <b>software engineering, film, and photography/videography</b>.</p>
            </div>
        </div>
    </div>
</Layout>
