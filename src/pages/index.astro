---
import Layout from '../layouts/Layout.astro';
import { getImage } from 'astro:assets';

const photowallModules = import.meta.glob<{ default: ImageMetadata }>(
    '../assets/photowall/*.{jpg,jpeg,png,webp,avif,gif}',
    { eager: true }
);

// Panels on the hero ring.
//
// Videos point at the PROXIES in /assets/ring/ — 480x270 H.264, no audio,
// made from the full-res originals in /assets/photogallery/. Two reasons:
// the ring samples each panel down to about 320px wide anyway, and iOS
// decodes H.264 in hardware where it decodes VP9/webm in software. The
// originals stay untouched for the full-size players on the work pages.
// To re-make a proxy after changing a source:
//   ffmpeg -i in.webm -an \
//     -vf "scale=480:270:force_original_aspect_ratio=increase,crop=480:270,fps=24" \
//     -c:v libx264 -profile:v main -pix_fmt yuv420p -crf 28 -preset slow \
//     -movflags +faststart out.mp4
//
// Stills come from src/assets/photowall/ so Astro optimizes them.
const ringConfig = [
    { video: '/assets/ring/Post1.mp4',      href: '/work/video', alt: 'Visual projects reel' },
    { video: '/assets/ring/City.mp4',       href: '/work/video/', alt: 'Visual projects reel' },
    { video: '/assets/ring/Post2.mp4',      href: '/work/video', alt: 'Visual projects reel' },
    { video: '/assets/ring/Tandonzine.mp4', href: '/work/video', alt: 'Visual projects reel' },
    { video: '/assets/ring/Post3.mp4',      href: '/work/video', alt: 'Visual projects reel' },
    { video: '/assets/ring/Post4.mp4',      href: '/work/video', alt: 'Visual projects reel' },
    { video: '/assets/ring/Post5.mp4',      href: '/work/video', alt: 'Visual projects reel' },
    // was 'Bamboo Garden.webm', which isn't in /assets/photogallery — that
    // panel was 404ing. Swap this for the real file once it's in the repo.
    { video: '/assets/ring/working.mp4',    href: '/work/video', alt: 'Visual projects reel' },
    { file: 'DSC05234-6.jpg',        href: '/work/photowall', alt: 'Photography' },
    { file: 'bananamatchalatte.jpg', href: '/work/photowall', alt: 'Photography' },
];

const ringClips = await Promise.all(
    ringConfig.map(async (item) => {
        if (item.video) {
            return { src: item.video, video: true, href: item.href, alt: item.alt };
        }
        const mod = photowallModules[`../assets/photowall/${item.file}`];
        const optimized = await getImage({
            src: mod.default,
            width: 700,
            format: 'webp',
            quality: 78,
        });
        return { src: optimized.src, href: item.href, alt: item.alt };
    })
);

const roleWords = ['software development', 'creative direction', 'photographer', 'videographer'];
---
<Layout includeGallery includeRing>
    <div class="fullscreen-content">
        <section class="ring-hero" aria-label="Featured work">
            <div
                class="ring-stage"
                data-ring-stage
                data-ring-clips={JSON.stringify(ringClips)}
            ></div>
        </section>

        <section class="hero">
            <h1 class="hero-name">Connor Ng</h1>

            <div class="hero-role">
                <span class="sr-only">{roleWords.join(', ')}</span>
                <div class="role-viewport" aria-hidden="true">
                    <span class="role-word role-a" id="role-a">{roleWords[0]}</span>
                    <span class="role-word role-b" id="role-b"></span>
                </div>
            </div>
        </section>

        <div class="intro-layout">
            <div class="intro-photo">
                <img src="/assets/photogallery/mephoto.png" alt="Connor Ng">
            </div>
            <div class="intro-text">
                <p><b>CONNOR NG</b> is a student at <b>New York University</b> studying computer science.</p>
                <p>His interests lie in <b>software engineering, film, and photography/videography</b>.</p>
            </div>
        </div>
    </div>
</Layout>
